[Unit]
Description=nbork apex SSH and HTTPS ingress
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nbork-ingress -host-key %d/ssh-key
LoadCredential=ssh-key:/etc/nbork-ingress/ssh_host_ed25519_key
StateDirectory=nbork-ingress
StateDirectoryMode=0700
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
