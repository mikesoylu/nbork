{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nbork",
  "main": "src/worker.ts",
  "build": { "command": "sh ssh-gateway/build-worker.sh" },
  "connect": [{ "protocol": "tcp", "port": 8788 }],
  "workers_dev": true,
  "placement": { "mode": "smart" },
  "vars": {
    "ROOT_DOMAIN": "nbork.com",
    "WEB_ORIGIN_HOST": "broker.nbork.com",
    // Destination IP to SSH channel. Use "*" for a single-channel endpoint.
    "SSH_ROUTES": {},
  },
  "compatibility_date": "2025-10-11",
  "migrations": [
    {
      "new_sqlite_classes": ["TunnelDO"],
      "tag": "v1",
    },
    { "new_sqlite_classes": ["SshGateway"], "tag": "v2" },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "TunnelDO",
        "name": "TUNNEL",
      },
      { "class_name": "SshGateway", "name": "SSH_GATEWAY" },
    ],
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    { "pattern": "*.nbork.com/*", "zone_name": "nbork.com" },
    { "pattern": "nbork.com/*", "zone_name": "nbork.com" },
  ],
}
