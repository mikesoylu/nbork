{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nbork",
  "main": "src/worker.ts",
  "workers_dev": true,
  "placement": { "mode": "smart" },
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  "vars": {
    "ROOT_DOMAIN": "nbork.com",
  },
  "compatibility_date": "2025-10-11",
  "migrations": [
    {
      "new_sqlite_classes": ["TunnelDO"],
      "tag": "v1",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "TunnelDO",
        "name": "TUNNEL",
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    { "pattern": "*.nbork.com/*", "zone_name": "nbork.com" },
    { "pattern": "nbork.com/*", "zone_name": "nbork.com" },
  ],
}
