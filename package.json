{
  "name": "nbork",
  "version": "0.3.0",
  "private": true,
  "description": "Cloudflare Worker broker for nbork tunnels",
  "keywords": [
    "tunnel",
    "cloudflare"
  ],
  "scripts": {
    "build": "sh ssh-gateway/build-worker.sh && tsc -p tsconfig.json",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "format": "prettier --write .",
    "lint": "biome lint --fix",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "biome": "^0.3.3",
    "prettier": "^3.6.2",
    "typescript": "^5.5.2",
    "wrangler": "^4.168.0"
  }
}
